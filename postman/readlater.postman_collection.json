          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reading-list/{{conflictItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reading-list",
                "{{conflictItemId}}"
              ]
            },
            "description": "Удаляем ресурс, созданный для проверки 409, чтобы папку можно было запустить повторно."
          },
          "response": []
        }
      ]
    }
  ]
