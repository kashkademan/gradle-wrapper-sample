                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET /api/v1/reading-list/999999999 -> 404\", function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
