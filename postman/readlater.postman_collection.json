              "path": [
                "api",
                "v1",
                "reading-list",
                "999999999"
              ]
            },
            "description": "Негативный сценарий для 404: id корректный по формату, но сущность с таким идентификатором отсутствует."
          },
          "response": []
        },
        {
          "name": "POST /health -> 405 + Allow header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST /health -> 405\", function () {",
                  "  pm.response.to.have.status(405);",
                  "});",
                  "",
                  "// 405 проверяем не только по статусу: заголовок Allow показывает, какие методы реально разрешены на этом endpoint.",
                  "pm.test(\"В ответе есть заголовок Allow\", function () {",
                  "  pm.expect(pm.response.headers.has(\"Allow\")).to.be.true;",
                  "  pm.expect(pm.response.headers.get(\"Allow\")).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Негативный сценарий для 405: путь существует, но метод на этом endpoint не разрешён."
          },
          "response": []
        },
        {
          "name": "POST /api/v1/reading-list -> 201 (подготовка к 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Исходный ресурс для проверки 409 создан\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "// id нужен, чтобы после проверки конфликта удалить этот ресурс.",
                  "pm.environment.set(\"conflictItemId\", String(pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ReadLater conflict item\",\n  \"sourceUrl\": \"https://example.com/readlater/conflict-item\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reading-list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reading-list"
              ]
            },
            "description": "Создаём ресурс, с которым столкнётся следующий запрос. Отдельный sourceUrl не пересекается с элементом из папки 02."
          },
          "response": []
        },
        {
          "name": "POST duplicate /api/v1/reading-list -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Повторяем тот же payload, что у предыдущего запроса, поэтому сервер получает точный дубликат.",
                  "pm.test(\"POST duplicate /api/v1/reading-list -> 409\", function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
