            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ReadLater conflict item\",\n  \"sourceUrl\": \"https://example.com/readlater/conflict-item\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reading-list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reading-list"
              ]
            },
            "description": "Негативный сценарий для 409: повторно создаём ресурс, только что созданный предыдущим запросом, с тем же payload."
          },
          "response": []
        },
        {
          "name": "DELETE /api/v1/reading-list/{{conflictItemId}} -> 204 (уборка после 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ресурс для проверки 409 удалён\", function () {",
                  "  pm.expect([200, 204]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.environment.unset(\"conflictItemId\");"
                ]
              }
